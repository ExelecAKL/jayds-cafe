{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "apps/admin/scripts/**/*.ts",
    "eslint.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".codex-logs"
  ]
}

# ============================================================
# CafeOS - Environment Variables
# Copy this file to .env.local in each app directory.
# ============================================================

# Supabase
# Default source of truth: hosted/online Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-online-anon-key

# SERVER-ONLY. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-online-service-role-key

# Server-only explicit extra browser origins, separated by commas. Keep empty
# for production unless another trusted app origin is required. LAN previews
# can list their exact URL and port; never use a wildcard.
CUSTOMER_ALLOWED_ORIGINS=

# Maya Business API
# Sandbox credentials from https://developers.maya.ph/reference/sandbox-credentials-and-cards
# Replace these with your own Maya Business Manager keys for production.
NEXT_PUBLIC_MAYA_PUBLIC_KEY=your_maya_sandbox_public_key
MAYA_SECRET_KEY=your_maya_sandbox_secret_key
MAYA_ENV=sandbox
# Webhooks retrieve payment details using MAYA_SECRET_KEY before updating orders.
# Configure Maya's published IP allowlist at the deployment edge.

# App Configuration
NEXT_PUBLIC_APP_NAME=CafeOS

# App URLs - update these for deployed environments.
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:4000
NEXT_PUBLIC_POS_URL=http://localhost:4001
NEXT_PUBLIC_ADMIN_URL=http://localhost:4002
